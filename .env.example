# .env.example — NAMES AND DOCUMENTATION ONLY. Never put real values here.
#
# The current portfolio is a fully static site and reads NONE of these variables.
# They document the server-side configuration a FUTURE, trusted chatbot backend
# would need (see docs/CHATBOT_ARCHITECTURE.md). Secrets must live ONLY in the
# serverless/edge environment — never in client-side code or the built bundle.
#
# To develop the (not-yet-built) chatbot locally: copy to `.env.local` and fill in.
# `.env.local` is gitignored.

# ----- Model provider (server-side only; choose ONE adapter) -----
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# CHAT_MODEL=claude-haiku-4-5-20251001

# ----- Chatbot guardrails (server-side only) -----
# CHAT_ALLOWED_ORIGIN=https://www.ekinsenler.com
# CHAT_RATE_LIMIT_PER_MIN=10
# CHAT_MAX_INPUT_CHARS=1000
# CHAT_MAX_HISTORY_TURNS=6
# CHAT_MAX_OUTPUT_TOKENS=600
# CHAT_MONTHLY_TOKEN_BUDGET=1000000
# CHAT_KILL_SWITCH=false
