{
  "name": "ekinsenler-portfolio",
  "version": "2.0.0",
  "description": "Personal portfolio of Ekin Senler (AI Engineer) — Astro static site.",
  "type": "module",
  "private": true,
  "homepage": "https://www.ekinsenler.com",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "og": "node scripts/generate-og.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "playwright test",
    "test:install": "playwright install --with-deps chromium",
    "test:links": "node scripts/check-links.mjs",
    "verify": "npm run check && npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@fontsource/poppins": "^5.1.0",
    "astro": "^5.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.49.0",
    "eslint": "^9.15.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^15.12.0",
    "prettier": "^3.4.1",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.33.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  }
}
